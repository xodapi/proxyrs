# OpenCode Proxy Configuration
# Copy this file to .env and fill in your values

# Server binding
# Note: Default port 3001 to avoid conflict with Node.js OpenCode proxy (port 3000)
HOST=127.0.0.1
PORT=3001

# Upstream OpenCode Zen API
UPSTREAM_URL=https://opencode.ai/zen/v1
UPSTREAM_TIMEOUT=30

# Available models (comma-separated)
MODELS=gpt-4,gpt-4-turbo,gpt-3.5-turbo,claude-3-opus,claude-3-sonnet

# Load balancing strategy: round-robin or random
ROUTING=round-robin

# Optional: Token for protecting /dashboard, /metrics, /usage, /export endpoints
# If set, these endpoints require: Authorization: Bearer {token}
MANAGEMENT_TOKEN=

# Usage analytics database location
# Default: ~/.config/opencode-proxy/usage.jsonl
USAGE_DB_PATH=~/.config/opencode-proxy/usage.jsonl

# How many days to retain usage history
USAGE_RETENTION_DAYS=30

# Logging level: debug, info, warn, error
RUST_LOG=info
